<% layout("layouts/boilerplate.ejs")-%>
 

<div class="outer_user_form">
<div id="loginForm" class="loginForm">

<form action="/user/otp_verification" method="post" id="login_Form">
  <div class="user_mobile">
    <label for="userMobileNo" class="form-label" >Mobile No.</label>
    <input type="text" class="form-control" id="userMobile" name="userMobile" value="<%=userMobile%>" readonly>
  </div>
  <br>
  
  <div class="user_password">
    <label for="password" class="form-label">OTP</label>
    <input type="code" placeholder="Enter OTP" class="form-control" id="password" name="code" required>
  </div>
  <br>

  <button type="submit" class="login_submit_button">Submitt OTP</button>
</form>
</div>
</div>