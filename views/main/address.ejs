<%layout("layouts/boilerplate.ejs")%>
<div class="address-section">
  <form action="/product/<%=productId%>/buy" method="post">
    <% for(address of req.user.address){ %>
      <label class="address-option">
        <input type="radio" name="selectedAddress" value="<%=address._id%>" class="address_selected">
        <div>
          <b><%=address.name%></b> — <%=address.mobileNumber%><br>
          <%=address.houseNumber%>, <%=address.city%> - <%=address.pincode%>
        </div>
      </label>
    <% } %>
    <input type="hidden" name="quantity" value="<%=quantity%>">
    <button type="submit">Proceed</button>
  </form>

  <a href="/user/new-address?productId=<%=productId%>&quantity=<%=quantity%>">
    ➕ Add New Address
  </a>
</div>
